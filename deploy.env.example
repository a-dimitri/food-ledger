# Copy this file to deploy.env and fill it in, then run ./deploy.sh
# deploy.env is gitignored — it holds your project id and (optionally) secrets.

# ── required ─────────────────────────────────────────────────────────────────

# Your Google Cloud project id (create one first — see README).
PROJECT_ID=my-diet-tracker

# The single Google account allowed to use the app. Only this address can sign
# in through IAP, and (if you enable the MCP server) complete its Google login.
ALLOWED_EMAIL=you@example.com

# ── optional ─────────────────────────────────────────────────────────────────

# Cloud Run region. Firestore is created in the same location by default.
# REGION=australia-southeast1

# Cloud Run service names.
# UI_SERVICE=tracker-ui
# MCP_SERVICE=tracker-mcp

# ── MCP server (only if you want Claude to read/write your tracker) ───────────
# Leave DEPLOY_MCP=no to deploy just the web UI.
#
# To enable: set DEPLOY_MCP=yes and run ./deploy.sh once. It deploys the service
# and prints the redirect URI to register on a new Google OAuth client. Create
# that client (README has the steps), paste its id/secret below, and re-run.
# DEPLOY_MCP=no
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
